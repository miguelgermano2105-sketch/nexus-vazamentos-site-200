# NEXUS VAZAMENTOS — variáveis de ambiente do SERVIDOR
# Nunca versione segredos: configure estes valores nas variáveis de ambiente
# da hospedagem (AppJet: Settings → Environment variables).

# Porta HTTP. A hospedagem injeta automaticamente; padrão 3000.
PORT=3000

# Banco de dados SQLite persistente (criado automaticamente).
DATA_DIR=./data
# DB_FILE=            # opcional: caminho completo do arquivo do banco

# NEXUS AI — provedor compatível com OpenAI.
# Sem chave a IA não responde (mostra erro controlado, nunca simula respostas).
OPENAI_API_KEY=
# AI_API_KEY=        # nome alternativo aceito pelo servidor
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1   # troque para outro provedor compatível

# Administrador inicial (opcional).
# O caminho recomendado é abrir /primeiro-acesso e criar a conta pelo navegador.
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
